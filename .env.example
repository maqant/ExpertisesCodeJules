# ExpertisesCodeJules — Variables d'environnement Vercel
# En production : à définir dans Vercel → Settings → Environment Variables
# En local : copier ce fichier vers .env.local (jamais commité)

# Clé API OpenAI (obligatoire pour les 18 processus IA)
VITE_OPENAI_API_KEY=sk-proj-votre_cle_openai_ici

# Configuration optionnelle
VITE_AI_MODE=live
VITE_AI_CONSOLE_LOGS=false
